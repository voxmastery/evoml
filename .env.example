# --- LLM picker auth -------------------------------------------------------
# claude_cli (default): uses your Claude subscription via headless `claude -p`.
#                        No key needed; just be logged in to Claude Code.
# api:                   uses the Anthropic API with ANTHROPIC_API_KEY.
PICKER_BACKEND=claude_cli
CLAUDE_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# --- Experiment mode ----------------------------------------------------------
# predict: directional forecasting experiment (no simulated buys/sells at all)
# trade:   paper buy/sell simulation with quote-priced fills
MODE=predict
PREDICT_MINUTES=15
HORIZON_MINUTES=30
MIN_PREDICTIONS=200

# --- Fill pricing (trade mode only) --------------------------------------------
# quote: price fills with real Jupiter swap quotes (read-only; most realistic)
# model: formula-based costs (LP fee + constant-product slippage)
FILL_MODEL=quote
# Optional key from portal.jup.ag for higher rate limits (lite endpoints
# are used without one). Read-only quoting either way.
JUPITER_API_KEY=

# --- Paper account ----------------------------------------------------------
START_BALANCE_INR=2000
INR_PER_USD=87.0

# --- Strategy ---------------------------------------------------------------
TARGET_PROFIT_USD=1.50
# Percent, e.g. 5 for -5%. Leave empty for "no stop" mode (original design).
STOP_LOSS_PCT=
POLL_SECONDS=5
PICK_MINUTES=30
# How often Claude re-analyzes the live chart of the held coin (HOLD/EXIT).
ANALYSIS_MINUTES=10

# --- Cost model (per side) --------------------------------------------------
LP_FEE_RATE=0.0025
PRIORITY_FEE_USD=0.04
TDS_RATE=0.01

# --- Data -------------------------------------------------------------------
# Optional comma-separated Solana mints always kept on the price watchlist.
WATCHLIST=So11111111111111111111111111111111111111112,DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263,EKpQGSJtjMFqKZ9KQanSqYXRcF8fBopzLHYxdM65zcjm
DB_PATH=data/memescalp.db
CSV_DIR=data/csv

# --- Dashboard / pass-fail --------------------------------------------------
DASH_PORT=8765
MIN_ROUND_TRIPS=200
MIN_DAYS=14
EDGE_Z_MIN=1.64

# --- EvoML prediction experiment (recommended settings) ----------------------
# MODE=predict, 5-minute windows, 15-minute horizon, Claude arm off.
# LLM_ARM=off makes the ML arm the experiment's subject; no AI API key needed.
LLM_ARM=off
# Watchlist mints are appended to the discovered universe (30 tokens total).
# WATCHLIST=So11111111111111111111111111111111111111112,...
